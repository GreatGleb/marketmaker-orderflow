DB_URL=postgresql+asyncpg://postgres:secret@db:5432/postgres

DB_HOST=db
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=secret
DB_SUPER_USER=postgres
DB_SUPER_PASSWORD=secret

BINANCE_API_KEY_TESTNET=32a8...22
BINANCE_SECRET_KEY_TESTNET=4d8...92
BINANCE_API_KEY=2b4...oq
BINANCE_SECRET_KEY=2DH...Ny

TELEGRAM_BOT_TOKEN=817...as
TELEGRAM_CHAT_ID=-100...33
TELEGRAM_TEST_BOT_TOPIC_ID=1
TELEGRAM_CELERY_TOPIC_ID=2
ENVIRONMENT=prod ;dev

# --- Redis -------------------------------------------------------------------
# Цены, очередь сделок, ключи копиботов, флаги запущенных симуляторов.
# Значение ниже — имя сервиса из docker-compose, то есть работает только
# внутри его сети. Менять нужно при запуске вне неё: с хоста это
# redis://localhost:6380/0 (порт из REDIS_PORT в корневом .env), на отдельной
# машине — её адрес.
REDIS_URL=redis://redis:6379/0

# Брокер celery (он же backend результатов). Пусто или строки нет — тот же
# REDIS_URL. Задавать отдельно только если очередь задач унесли на свой
# инстанс.
# CELERY_BROKER=

# CELERY_BROKER_URL и CELERY_RESULT_BACKEND здесь больше не нужны и ни на
# что не влияют: celery читает их из окружения раньше настройки, поэтому
# app/tasks.py сам перезаписывает обе значением CELERY_BROKER. Если они
# остались в вашем .env с прошлых версий — просто удалите, чтобы не вводить
# в заблуждение; вреда от них уже нет.

# Источник рыночных данных для app.scripts.watch_ws_and_save:
#   ws   - поток wss://fstream.binance.com/ws/!ticker@arr (боевое поведение)
#   rest    - поллинг https://fapi.binance.com/fapi/v1/ticker/24hr
#   spot_ws - спотовый WS Binance по watched-парам, максимальная частота
#             (внимание: спотовые цены отличаются от фьючерсных)
# REST нужен там, где Binance не отдаёт USDT-M push-поток (EEA).
MARKET_DATA_SOURCE=ws
MARKET_DATA_REST_INTERVAL_SEC=2
MARKET_DATA_SPOT_SYMBOLS=watched
MARKET_DATA_SPOT_STREAM=bookTicker
MARKET_DATA_SPOT_FLUSH_SEC=0.2

# --- Ретеншн -----------------------------------------------------------------
# Без чистки база растёт на гигабайты в сутки и 80 ГБ кончаются за неделю.
# Значения ниже — умолчания из app/config.py, менять их надо осознанно.
RETENTION_ENABLED=true
# Сколько держать сырые строки, в часах.
RETENTION_ASSET_HISTORY_HOURS=24
# НЕ СТАВИТЬ МЕНЬШЕ 48: самое длинное окно прибыльности копиботов — 2880 минут,
# на более короткой истории оно молча начнёт считаться по неполным данным.
RETENTION_TEST_ORDERS_HOURS=72
RETENTION_ORDER_BOOK_HOURS=24
# Размер пачки удаления и потолок времени на один проход.
RETENTION_BATCH_ROWS=50000
RETENTION_MAX_SECONDS=900
# pg_repack после чистки. Возвращает место операционной системе, но требует
# свободного места в размер таблицы вместе с индексами — на заполненном диске
# добьёт сервер. Обычному DELETE это не нужно: таблица просто перестаёт расти.
RETENTION_REPACK=false

# Свёртки test_orders: то, что остаётся от сделок после чистки. Пока блок не
# свёрнут, ретеншн его сырьё не трогает — выключать без нужды не стоит.
ROLLUP_ENABLED=true
ROLLUP_BUCKET_MINUTES=10
ROLLUP_LAG_MINUTES=60
ROLLUP_MAX_SECONDS=300
# Сколько хранить свёртки. Пусто (как сейчас) — бессрочно: это единственное,
# что остаётся от эксперимента, и выбрасывать их должен человек, а не
# расписание. Ноль и отрицательные значения тоже означают «не удалять».
#
# Но место они занимают, и оно зависит только от числа ботов, не от числа
# сделок: 637 МБ в сутки на парке в 17 236 ботов (замер). То есть 2 месяца —
# 38 ГБ, полгода — 113 ГБ. Следить за размером обязательно:
#   select pg_size_pretty(pg_total_relation_size('test_order_rollups'));
# RETENTION_ROLLUP_DAYS=

# --- Шарды симулятора --------------------------------------------------------
# На сколько процессов делится парк тестовых ботов. Один событийный цикл
# держит около 70 тысяч пробуждений корутин в секунду на ядро — это 4–7 тысяч
# ботов с тактом 100 мс. Больше ботов в процессе — такт растягивается, и
# условия выхода проверяются реже, чем задумано.
#
#   до ~7 000 ботов      → 1
#   полный парк 17 236   → 4
#
# Переменную читает supervisord (numprocs у программы test_bots), поэтому
# после изменения контейнер надо пересоздать: ./run.sh restart. Каждый шард
# заново строит свой shared_data и держит своё соединение с базой — ставить
# больше, чем нужно, незачем. Процессы называются test_bots:test_bots_00,
# test_bots:test_bots_01 и так далее.
TEST_BOTS_SHARDS=1
